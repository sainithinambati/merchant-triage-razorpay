# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# Shared secrets (generate long random strings)
WEBHOOK_SECRET=
CRON_SECRET=

# Dashboard login (HTTP basic auth). Username is recorded as the approver.
DASHBOARD_USERS=sai:change-me,agent2:change-me-too

# Optional: where approved / auto-sent replies are POSTed (email service, CRM). Leave blank to only store them.
OUTBOUND_WEBHOOK_URL=

# Optional: pretend "today" is this date (YYYY-MM-DD). The sample merchant data is from late Sep 2026.
PIPELINE_TODAY=
